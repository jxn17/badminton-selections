# --- Database ---
# Docker Postgres (default) or a managed URL (Railway/Neon/Supabase).
# All queries run on asyncpg. Provider-style 'postgres://...' (and the old
# '+psycopg2' spelling) are auto-normalized, and libpq-only params such as
# '?sslmode=require' are translated, so an existing URL can be pasted as-is.
DATABASE_URL=postgresql+asyncpg://badminton:badminton@localhost:5432/badminton

# --- Admin access ---
# Shared code that admins type to log in and edit. Use a strong value.
ADMIN_ACCESS_CODE=trials2026

# --- Session cookie signing ---
SECRET_KEY=change-me-to-a-long-random-string

# Frontend origin (CORS + Secure-cookie decision). For the single-origin Railway
# deploy, set this to the app's own https URL.
FRONTEND_URL=http://localhost:5173

# --- Public read cache ---
# Seconds the anonymous bracket/draws responses may be served from memory.
# Any admin write clears the cache immediately, so this only delays data that
# has not changed. Set to 1 to effectively disable it.
PUBLIC_CACHE_TTL=45
