# --- Database ---
# Point this at Docker Postgres (default) or a managed instance later.
DATABASE_URL=postgresql+psycopg2://badminton:badminton@localhost:5432/badminton

# --- Admin bootstrap ---
# Comma-separated list of Google emails granted admin on startup.
ADMIN_EMAILS=you@example.com,coach@example.com

# --- Session / cookie signing ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Google OAuth (create at https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where Google redirects back after login (must match the console config):
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Frontend origin, for CORS + post-login redirect.
FRONTEND_URL=http://localhost:5173

# DEV ONLY: set true to enable /api/auth/dev-login (skips Google). Keep false in prod.
ALLOW_DEV_LOGIN=false
