# --- Database ---
# Docker Postgres (default) or a managed URL (Railway/Neon/Supabase).
# Provider-style 'postgres://...' is auto-normalized for SQLAlchemy.
DATABASE_URL=postgresql+psycopg2://badminton:badminton@localhost:5432/badminton

# --- Admin access ---
# Shared code that admins type to log in and edit. Use a strong value.
ADMIN_ACCESS_CODE=trials2026

# --- Session cookie signing ---
SECRET_KEY=change-me-to-a-long-random-string

# Frontend origin (CORS + Secure-cookie decision). For the single-origin Railway
# deploy, set this to the app's own https URL.
FRONTEND_URL=http://localhost:5173
